{
  "name": "dsh-mind-system-monorepo",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 心智系统 —— 判断顺序、按处境编排、因果结构判据、五层记忆判据，一套装齐。",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-combined.mjs",
    "build:prune": "node scripts/build-combined.mjs --prune",
    "verify-combined": "node scripts/verify-combined.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "test": "npm run verify-combined && node scripts/verify-readme.mjs && node scripts/verify-subpackages.mjs && node scripts/verify-subpackage-structure.mjs && node scripts/verify-plan.mjs && node packages/dsh-mind-system/test/run-all.mjs && node packages/dsh-mind-system/scripts/publish-check.mjs",
    "verify-readme": "node scripts/verify-readme.mjs",
    "verify-subpackages": "node scripts/verify-subpackages.mjs",
    "verify-structure": "node scripts/verify-subpackage-structure.mjs",
    "verify-plan": "node scripts/verify-plan.mjs",
    "publish-check": "node packages/dsh-mind-system/scripts/publish-check.mjs",
    "test:mind": "node --test \"packages/dsh-agent-mind/test/*.test.js\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-mind",
    "orchestration",
    "causal",
    "memory"
  ],
  "private": true
}
