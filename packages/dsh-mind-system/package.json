{
  "name": "dsh-mind-system",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "DSH 心智系统（合成包）：判断顺序常驻、按处境编排工具面、因果结构判据、五层记忆判据与自我迭代闭环——四家源码并入一包，一个装载点。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-mind",
    "orchestration",
    "causal",
    "memory"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./clis-classifier": "./clis/clis-classifier.js",
    "./clis-strategy": "./clis/clis-strategy.js",
    "./clis-feedback": "./clis/clis-feedback.js",
    "./clis-orchestrator": "./clis/clis-orchestrator.js",
    "./clis": "./clis/index.js",
    "./agent-mind": "./mind/index.js",
    "./meta-framework": "./meta/index.js",
    "./memory-manager": "./memory/server.js",
    "./client": "./memory/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "build-stamp.json",
    "clis/",
    "mind/",
    "meta/",
    "memory/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandlersn/dsh-mind-system.git",
    "directory": "packages/dsh-mind-system"
  }
}
