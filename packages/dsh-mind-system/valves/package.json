  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./predicates": "./src/predicates.js",
    "./store": "./src/store.js",
    "./thresholds": "./src/thresholds.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml",
    "README.md"
  ],
