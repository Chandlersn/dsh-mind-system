{
  "name": "dsh-execution-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated exception-driven execution runtime contracts and development probes.",
  "engines": { "node": ">=22.23.0" },
  "exports": {
    "./contracts": "./src/contracts.js",
    "./store": "./src/store.js",
    "./json-recipe": "./recipes/json-normalize.js",
    "./json-repair": "./recipes/json-repair.js",
    "./decision-client": "./src/decision-client.js",
    "./admission": "./src/admission.js",
    "./executor": "./src/executor.js",
    "./scheduler": "./src/scheduler.js",
    "./analyzer": "./src/analyzer.js",
    "./exceptions": "./src/exceptions.js",
    "./probes": "./src/probes.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify:core": "node scripts/verify-core-mutations.mjs",
    "verify:phase1": "node scripts/verify-phase1-mutations.mjs",
    "verify:analysis": "node scripts/verify-analysis-mutations.mjs",
    "verify:repair": "node scripts/verify-repair-mutations.mjs",
    "verify:recovery": "node scripts/verify-recovery-mutations.mjs",
    "probe:jev": "node scripts/probe-jev.mjs"
  }
}
